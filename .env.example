# 复制成 .env 后按需修改。.env 已被 .gitignore 忽略，不要提交。
#
# 注意：本项目**不需要**任何外部 API Key。
# 整个流程（数据合成、训练、推理、服务）都在本地/内网完成，
# 这正是这个项目的业务前提——数据不出内网。
# 如果你的部署环境里出现了某个 AI 服务的 Key，那说明有环节走错了。

# ---- 推理服务 ----
# transformers：本机可用，适合开发演示
# vllm：生产环境，需要 NVIDIA GPU
AUDIT_BACKEND=transformers

# transformers 后端用
BASE_MODEL=models/Qwen2.5-0.5B-Instruct
ADAPTER=outputs/qwen2.5-0.5b-lora
DTYPE=float32

# vllm 后端用
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL_NAME=question-audit
VLLM_PORT=8001

# FastAPI 对外端口
API_PORT=8000

# ---- 运行环境 ----
# 断网运行。设成 1 之后 transformers/huggingface_hub 不会尝试外连，
# 模型必须已经在本地。这是「数据不出内网」在运行时的兜底。
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ---- 下载模型时的镜像（只在需要下载时用）----
# HF_ENDPOINT=https://hf-mirror.com
